# ========================================
# PRIMARY AGENT - TeacherBOY (Translation Bot)
# ========================================
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
MATON_CHANNEL_SECRET=your_maton_channel_secret_here
MATON_CHANNEL_ACCESS_TOKEN=


# ========================================
# ADDITIONAL AGENTS (Optional)
# ========================================
# Format: JSON string with agent configurations
# Example: {"math_agent": {"channel_secret": "...", "channel_access_token": "..."}}
# Leave empty if only using primary agent
ADDITIONAL_AGENTS=

# ========================================
# ADMIN CONTROL CONFIGURATION
# ========================================
# Comma-separated list of LINE user IDs authorized as admins
# Get user ID from webhook logs when a user sends a message
# Example: ADMIN_USER_IDS=U1234567890abcdef,U9876543210fedcba
ADMIN_USER_IDS=

# Optional one-time bootstrap key for claiming admin rights
# Set this, restart bot, then run: /admin claim <key>
# After claiming, set ADMIN_USER_IDS with your ID and remove this key
ADMIN_SETUP_KEY=

# Comma-separated list of LINE user IDs authorized as moderators
# Moderators get direct news access without translation (like admins) but no admin commands
# Example: MODERATOR_USER_IDS=U1234567890abcdef,U9876543210fedcba
MODERATOR_USER_IDS=

# ========================================
# AI TRANSLATION
# ========================================

# Translation is handled by the AI providers configured below.
# GitHub Models is preferred when configured; OpenRouter is used as fallback.

# Translation Performance Optimization
TRANSLATION_CACHE_TTL_SECONDS=3600  # Cache translations for 1 hour (0 to disable)
TRANSLATION_MAX_RETRIES=3           # Retry failed translations up to 3 times

# ========================================
# NEWS AGENT CONFIGURATION
# ========================================
# Cache TTL settings for news data (in seconds)
WEATHER_CACHE_TTL_SECONDS=1800       # Weather/air quality cache: 30 minutes (default)
NEWS_CACHE_TTL_SECONDS=3600          # News headlines cache: 1 hour (default)
HOLIDAY_CACHE_TTL_SECONDS=604800     # Thai holidays cache: 7 days (default)
BITCOIN_CACHE_TTL_SECONDS=300        # Bitcoin/crypto price cache: 5 minutes (default)
EXCHANGE_CACHE_TTL_SECONDS=3600      # Exchange rates cache: 1 hour (default)
COLOR_CACHE_TTL_SECONDS=86400        # Lucky color cache: 24 hours (default)
SUNSET_CACHE_TTL_SECONDS=86400       # Sunset/sunrise cache: 24 hours (default)
FRIEND_CACHE_TTL_SECONDS=300         # Friend status cache: 5 minutes (default)

# Optional API Keys for Extended News Features
EXCHANGE_RATE_API_KEY=               # ExchangeRate-API key (1500 req/mo free)
TAT_API_KEY=                         # Tourism Authority of Thailand API key

# ========================================
# AI CONFIGURATION (LLM Providers)
# ========================================

# GitHub Models API (FREE - Recommended for vision/profiling)
# Create PAT at https://github.com/settings/tokens with 'models:read' scope
# Free tier: 15 rpm / 150 rpd (low tier), 10 rpm / 50 rpd (high tier)
GITHUB_MODELS_PAT=
GITHUB_MODELS_DEFAULT_MODEL=github-copilot/gpt-4o
# Available models: github-copilot/gpt-4o, github-copilot/gpt-4o-mini, xai/grok-3, deepseek/deepseek-r1, meta/llama-3.3-70b-instruct

# OpenRouter API (Fallback LLM Provider)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemma-2-9b-it
# Hugging Face Spaces convenience alias (optional):
# DEFAULT_MODEL=

# LLM Provider Priority (comma-separated, first configured wins)
LLM_PROVIDER_PRIORITY=github,openrouter

# LLM Personality & Behavior
LLM_SYSTEM_PROMPT="You are Zeus, king of the Olympian gods. Your tone is wise, measured, and authoritative, yet you carry the warmth of a benevolent ruler who cares for those who seek your counsel. Be direct and insightful, but not cold. A touch of paternal wisdom is welcome. Keep answers concise. Light mythological references are fine when they add value."
LLM_TEMPERATURE=1.15  # Creativity level (0.0-2.0, higher = more creative)

# Zeus AI Access Control (group/room chats)
ZEUS_GROUP_ACCESS_MODE=all  # Options: all, allowlist, denylist
ZEUS_ALLOWED_GROUP_IDS=     # Comma-separated group/room IDs (for allowlist mode)
ZEUS_DENIED_GROUP_IDS=      # Comma-separated group/room IDs (for denylist mode)

# Web Search (Brave Search API)
BRAVE_SEARCH_API_KEY=

# ========================================
# CONVERSATION MEMORY (Hugging Face Hub Persistence)
# ========================================
# Enable contextual multi-turn conversations with memory
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MAX_MESSAGES=20       # Max messages per session (5-50)
CONVERSATION_TTL_HOURS=24          # Session expiry time (1-168 hours)

# Hugging Face Hub Persistence (optional - stores conversations in HF dataset)
HF_MEMORY_TOKEN=                   # HF token with 'write' scope: https://huggingface.co/settings/tokens
HF_MEMORY_REPO_ID=                 # Example: username/zeus-memory (auto-created as private)

# ========================================
# DOCUMENT MEMORY (PDF/DOCX Persistence)
# ========================================
DOCUMENT_MEMORY_ENABLED=true
DOCUMENT_STORAGE_PATH=./data/documents
DOCUMENT_MAX_FILE_SIZE_MB=10.0     # Max document size (1-50 MB)
DOCUMENT_MAX_TEXT_CHARS=80000      # Max extracted text per document
DOCUMENT_HF_REPO_ID=               # Example: username/zeus-documents (auto-created as private)

# ========================================
# HISTORY LOGGING (Audit Trail + Cloud Backup)
# ========================================
HISTORY_LOG_ENABLED=true
HISTORY_LOG_PATH=./data/logs       # Local storage directory
HISTORY_LOG_ROTATION_DAYS=7        # Archive old logs after N days (1-30)
ZEUS_ERROR_STYLE=true              # Format errors in Zeus's mythological style

# Optional: Encrypt sensitive log data
HISTORY_LOG_ENCRYPTION_KEY=        # AES encryption key (requires 'cryptography' package)

# Optional: Cloud backup to Hugging Face Hub
HISTORY_LOG_HF_REPO_ID=            # Example: username/zeus-logs (auto-created as private)
# Note: Uses HF_MEMORY_TOKEN if set above

# ========================================
# PSYCHOLOGICAL PROFILER (Vision AI - FaceLLaVA)
# ========================================
# Facial/psychological profiling using FBI/Ekman/Navarro frameworks
PROFILER_ENABLED=true
PROFILER_MODEL=openai/gpt-4o       # Vision-capable model (gpt-4o or gpt-4o-mini)
PROFILER_ANALYSIS_TYPE=full        # Options: full, quick, body, facial
PROFILER_ANALYSIS_DEPTH=standard   # Token optimization: quick (~800), standard (~1800), full (~2400)
PROFILER_RATE_LIMIT_PER_HOUR=3     # Max analyses per hour per chat (1-20)
PROFILER_MAX_IMAGE_SIZE_MB=10.0    # Max image file size (1.0-20.0 MB)

# ========================================
# PRODUCTIVITY OPTIMIZATIONS
# ========================================
# Enable modular prompt system for 60-70% token reduction
USE_OPTIMIZED_PROMPTS=true

# Enable automatic conversation summarization (60-80% token reduction in memory)
ENABLE_CONVERSATION_SUMMARIZATION=true
CONVERSATION_SUMMARY_INTERVAL=10       # Trigger summarization after N messages (5-30)
CONVERSATION_MESSAGES_TO_KEEP_FULL=6   # Recent messages to keep in full (3-15)

# ========================================
# HTTP CLIENT CONFIGURATION
# ========================================
HTTP_CLIENT_TIMEOUT_SECONDS=30       # Request timeout in seconds
HTTP_CLIENT_MAX_CONNECTIONS=100      # Max concurrent connections
HTTP_CLIENT_MAX_KEEPALIVE=20         # Max keep-alive connections

# ========================================
# SERVER CONFIGURATION
# ========================================
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Performance & Monitoring
ENABLE_REQUEST_LOGGING=True          # Log all requests/responses
ENABLE_PERFORMANCE_METRICS=True      # Collect performance metrics

# Tracing (OpenTelemetry)
# To view traces in VS Code AI Toolkit, run the command: "AI Toolkit: Open Tracing"
ENABLE_TRACING=False
OTEL_SERVICE_NAME=TeacherBOY
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================================================
# Calendar & Reminder Configuration
# ============================================================================

# Enable/disable calendar and reminder functionality
CALENDAR_ENABLED=true

# Hour (0-23) for daily calendar reminders in server timezone
CALENDAR_REMINDER_HOUR=8

# Local directory path for calendar event storage
CALENDAR_DATA_PATH=./data/calendar

# Optional: Hugging Face repository ID for calendar data synchronization
# Requires HF_MEMORY_TOKEN to be set above
# CALENDAR_HF_REPO_ID=username/calendar-data

# Interval in seconds between Hugging Face sync operations
CALENDAR_SYNC_INTERVAL_SECONDS=300

# ========================================
# MCP CONFIGURATION
# ========================================
MCP_SERVER_URL=http://localhost:3000

# Convex structured persistence
PERSISTENCE_BACKEND=local
CONVEX_DEPLOYMENT_URL=
CONVEX_SYNC_TOKEN=
CONVEX_REQUEST_TIMEOUT_SECONDS=10
CONVEX_REQUIRE_HEALTHCHECK_ON_STARTUP=false
