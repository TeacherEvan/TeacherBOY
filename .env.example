# ========================================
# PRIMARY AGENT - Brown (Translation Bot)
# ========================================
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ========================================
# ADDITIONAL AGENTS (Optional)
# ========================================
# Format: JSON string with agent configurations
# Example: {"math_agent": {"channel_secret": "...", "channel_access_token": "..."}}
# Leave empty if only using primary agent
ADDITIONAL_AGENTS=

# ========================================
# TRANSLATION APIs
# ========================================

# Google Cloud Translation API (RECOMMENDED - Best Quality)
# Get API key: https://console.cloud.google.com/apis/credentials
# Enable Cloud Translation API: https://console.cloud.google.com/apis/library/translate.googleapis.com
# First 500K characters/month FREE!
GOOGLE_TRANSLATE_API_KEY=

# LibreTranslate API Configuration (Fallback if Google not configured)
LIBRETRANSLATE_API_URL=https://libretranslate.de/translate
LIBRETRANSLATE_API_KEY=

# ========================================
# SERVER CONFIGURATION
# ========================================
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ========================================
# MCP CONFIGURATION
# ========================================
MCP_SERVER_URL=http://localhost:3000
