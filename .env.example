# ========================================
# PRIMARY AGENT - TeacherBOY (Translation Bot)
# ========================================
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ========================================
# ADDITIONAL AGENTS (Optional)
# ========================================
# Format: JSON string with agent configurations
# Example: {"math_agent": {"channel_secret": "...", "channel_access_token": "..."}}
# Leave empty if only using primary agent
ADDITIONAL_AGENTS=

# ========================================
# TRANSLATION APIs
# ========================================

# Google Cloud Translation API (RECOMMENDED - Best Quality)
# Get API key: https://console.cloud.google.com/apis/credentials
# Enable Cloud Translation API: https://console.cloud.google.com/apis/library/translate.googleapis.com
# First 500K characters/month FREE!
GOOGLE_TRANSLATE_API_KEY=

# LibreTranslate API Configuration (Fallback if Google not configured)
LIBRETRANSLATE_API_URL=https://libretranslate.de/translate
LIBRETRANSLATE_API_KEY=

# Translation Performance Optimization
TRANSLATION_CACHE_TTL_SECONDS=3600  # Cache translations for 1 hour (0 to disable)
TRANSLATION_MAX_RETRIES=3           # Retry failed translations up to 3 times

# ========================================
# GOOGLE CALENDAR CONFIGURATION
# ========================================
# LINE Group Chat ID for calendar reminders
# You can get this ID when the bot joins a group (check webhook logs)
GOOGLE_CALENDAR_GROUP_ID=

# Timezone for scheduled reminders (default: Asia/Bangkok)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
CALENDAR_TIMEZONE=Asia/Bangkok

# Schedule times (24-hour format)
# Morning reminder: Today's events
CALENDAR_MORNING_HOUR=7
# Afternoon overview: This week's events  
CALENDAR_AFTERNOON_HOUR=14

# ========================================
# HTTP CLIENT CONFIGURATION
# ========================================
HTTP_CLIENT_TIMEOUT_SECONDS=30       # Request timeout in seconds
HTTP_CLIENT_MAX_CONNECTIONS=100      # Max concurrent connections
HTTP_CLIENT_MAX_KEEPALIVE=20         # Max keep-alive connections

# ========================================
# SERVER CONFIGURATION
# ========================================
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Performance & Monitoring
ENABLE_REQUEST_LOGGING=True          # Log all requests/responses
ENABLE_PERFORMANCE_METRICS=True      # Collect performance metrics

# ========================================
# MCP CONFIGURATION
# ========================================
MCP_SERVER_URL=http://localhost:3000
